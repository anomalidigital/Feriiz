@page "/forgot-password"
@layout EmptyLayout
@inject NavigationManager Nav

<PageTitle>Feriiz - Forgot Password</PageTitle>

<div class="login-body">
    <div class="login-card">
        <div class="login-card-header">
            <img src="assets/images/icon_feriiz.png" alt="Feriiz" class="login-card-logo" />
            <h1 class="login-title">Forgot Password</h1>
            <p class="login-subtitle">Enter your email and we'll send you a reset link</p>
        </div>

        @if (!_sent)
        {
            <form class="login-form" @onsubmit="Send" @onsubmit:preventDefault>
                <div class="login-field">
                    <label for="forgotEmail">Email address</label>
                    <div class="login-input-wrap">
                        <i class="fa-regular fa-envelope"></i>
                        <input type="email" id="forgotEmail" class="input" required
                               placeholder="Enter your registered email" @bind="_email" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary login-btn" disabled="@_sending">
                    @if (_sending)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <text> Sending...</text>
                    }
                    else
                    {
                        <i class="fa-solid fa-paper-plane"></i>
                        <text> Send Reset Link</text>
                    }
                </button>
            </form>
        }
        else
        {
            <div class="forgot-success" style="display:block;">
                <div class="forgot-success-icon">
                    <i class="fa-solid fa-envelope-circle-check"></i>
                </div>
                <h2 class="forgot-success-title">Check your email</h2>
                <p class="forgot-success-msg">
                    We've sent a password reset link to <strong>@_email</strong>
                </p>
                <p class="forgot-success-hint">Didn't receive it? Check your spam folder or try again.</p>
                <button class="btn btn-outline login-btn" @onclick="Reset">
                    <i class="fa-solid fa-arrow-rotate-left"></i>
                    Try another email
                </button>
            </div>
        }

        <div class="login-footer">
            <a href="login" class="forgot-back-link">
                <i class="fa-solid fa-arrow-left"></i> Back to Login
            </a>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private bool _sending;
    private bool _sent;

    /// <summary>Login passes the address along as ?email= so it does not have to be retyped.</summary>
    protected override void OnInitialized() =>
        _email = QueryString.Get(Nav.Uri, "email") ?? "";

    private async Task Send()
    {
        _sending = true;
        await Task.Delay(1500);   // demo only: no mail is actually sent
        _sending = false;
        _sent = true;
    }

    private void Reset()
    {
        _sent = false;
        _email = "";
    }
}
